# Set a strong random value; never commit the real value.
APP_KEY=

# Optional P1/P2 integrations
PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

